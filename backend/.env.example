# Copy to .env (never commit .env). Real values come from the deployment environment.
NODE_ENV=development
PORT=3000
# >= 32 random characters, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
TOKEN_TTL_SEC=900
CORS_ORIGINS=http://localhost:8080
# HTTPS (generate a dev cert with: sh scripts/gen-dev-cert.sh)
TLS_KEY_FILE=certs/dev-key.pem
TLS_CERT_FILE=certs/dev-cert.pem
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MS=900000
